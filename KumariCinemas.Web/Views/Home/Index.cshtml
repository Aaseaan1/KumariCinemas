@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid mt-4">

    <!-- Home Header -->
    <div class="d-flex flex-column justify-content-center align-items-center text-center mb-5"
         style="min-height:250px;">

        <h1 class="display-3 fw-bold text-white">
            Kumari Cinemas
        </h1>

        <p class="lead text-white" style="max-width:800px;">
            Welcome to Kumari Cinemas! Manage Your Movies, Showtimes, Users and Bookings All in One Place.
        </p>

    </div>

    <div class="row">

        <!-- LEFT SIDE -->
        <div class="col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-header text-center">
                    <h4>Booking Status</h4>
                </div>

                <div class="card-body">
                    <canvas id="bookingChart"></canvas>
                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-8">

            <div class="row g-3">

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Movies"
                       asp-action="Index">
                        View Movies
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Showtimes"
                       asp-action="Index">
                        View Showtimes
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Users"
                       asp-action="Index">
                        Manage Users
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Halls"
                       asp-action="Index">
                        Manage Halls
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Bookings"
                       asp-action="Index">
                        Manage Bookings
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="Reports"
                       asp-action="Index">
                        View Reports
                    </a>
                </div>

                <div class="col-md-6">
                    <a class="btn btn-outline-primary w-100 py-5 home-action-btn"
                       asp-controller="ViewComplex"
                       asp-action="Index">
                        View Complex
                    </a>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ctx = document.getElementById('bookingChart');

new Chart(ctx, {

    type: 'pie',

    data: {

        labels: [
            'Booked',
            'Cancelled',
            'Pending'
        ],

        datasets: [{

            data: [
                @ViewBag.Booked,
                @ViewBag.Cancelled,
                @ViewBag.Pending
            ],

            backgroundColor: [
                '#198754',
                '#dc3545',
                '#fd7e14'
            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        plugins: {

            legend: {
                position: 'bottom'
            }

        }

    }

});

</script>

}
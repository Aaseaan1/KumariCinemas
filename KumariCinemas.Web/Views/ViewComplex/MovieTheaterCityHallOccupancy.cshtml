@model KumariCinemas.Web.Models.MovieTheaterCityHallOccupancyViewModel

@{
    ViewData["Title"] = "Movie Theater City Hall Occupancy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Movie Theater City Hall Occupancy</h1>
    <a class="btn btn-outline-light" asp-action="Index">&larr; Back to View Complex</a>
</div>

<div class="card shadow mb-4">
    <div class="card-header">
        <h5 class="mb-0">Select Movie</h5>
    </div>
    <div class="card-body">
        <form asp-action="MovieTheaterCityHallOccupancy" method="get" class="row g-3">
            <div class="col-md-8">
                <label for="selectedMovieId" class="form-label">Movie</label>
                <select id="selectedMovieId" name="selectedMovieId" class="form-select">
                    <option value="">-- Select Movie --</option>
                    @foreach (var movie in Model.Movies)
                    {
                        <option value="@movie.Value" selected="@(movie.Value == Model.SelectedMovieId.ToString() ? "selected" : null)">
                            @movie.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Show Occupancy</button>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedMovieId.HasValue)
{
    <div class="card shadow mb-4">
        <div class="card-header">
            <h5 class="mb-0">Top 3 Theater City Halls by Paid Seat Occupancy</h5>
        </div>
        <div class="card-body">
            @if (Model.Occupancies.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Rank</th>
                            <th>Theater Name</th>
                            <th>City</th>
                            <th>Hall Capacity</th>
                            <th>Paid Tickets</th>
                            <th>Occupancy %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var item in Model.Occupancies)
                        {
                            <tr>
                                <td>
                                    @if (rank == 1)
                                    {
                                        <span class="badge bg-warning">#@rank</span>
                                    }
                                    else if (rank == 2)
                                    {
                                        <span class="badge bg-secondary">#@rank</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">#@rank</span>
                                    }
                                </td>
                                <td>@item.TheaterName</td>
                                <td>@item.TheaterCity</td>
                                <td>@item.HallCapacity</td>
                                <td>@item.PaidTickets</td>
                                <td>
                                    @item.OccupancyPercentage.ToString("F1")%
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No occupancy data available for the selected movie.</div>
            }
        </div>
    </div>
}

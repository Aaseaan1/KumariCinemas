@model KumariCinemas.Web.Models.UserTicketViewModel

@{
    ViewData["Title"] = "User Ticket";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>User Ticket</h1>
    <a class="btn btn-outline-light" asp-action="Index">&larr; Back to View Complex</a>
</div>

<div class="card shadow mb-4">
    <div class="card-header">
        <h5 class="mb-0">Filter Options</h5>
    </div>
    <div class="card-body">
        <form asp-action="UserTicket" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="selectedUserId" class="form-label">Select User</label>
                <select id="selectedUserId" name="selectedUserId" class="form-select">
                    <option value="">-- Select User --</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Value" selected="@(user.Value == Model.SelectedUserId.ToString() ? "selected" : null)">
                            @user.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" id="startDate" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label">End Date</label>
                <input type="date" id="endDate" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Show Tickets</button>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedUserId.HasValue)
{
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Tickets</h5>
            <span class="badge bg-primary">Period: @Model.StartDate.ToString("yyyy-MM-dd") to @Model.EndDate.ToString("yyyy-MM-dd")</span>
        </div>
        <div class="card-body">
            @if (Model.Tickets.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Ticket ID</th>
                            <th>Movie</th>
                            <th>Theater</th>
                            <th>City</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th>Ticket Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td>@ticket.TicketId</td>
                                <td>@ticket.MovieTitle</td>
                                <td>@ticket.TheaterName</td>
                                <td>@ticket.TheaterCity</td>
                                <td>@ticket.ShowDate.ToString("yyyy-MM-dd")</td>
                                <td>@ticket.ShowTimeName</td>
                                <td>@ticket.TicketPrice.ToString("C")</td>
                                <td>
                                    @if (ticket.BookingStatus == "Booked")
                                    {
                                        <span class="badge bg-success">@ticket.BookingStatus</span>
                                    }
                                    else if (ticket.BookingStatus == "Pending")
                                    {
                                        <span class="badge bg-warning">@ticket.BookingStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@ticket.BookingStatus</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No tickets found for the selected user in this period.</div>
            }
        </div>
    </div>
}

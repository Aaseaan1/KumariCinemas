@model KumariCinemas.Web.Models.TheaterCityHallMovieViewModel

@{
    ViewData["Title"] = "Theater City Hall Movie";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Theater City Hall Movie</h1>
    <a class="btn btn-outline-light" asp-action="Index">&larr; Back to View Complex</a>
</div>

<div class="card shadow mb-4">
    <div class="card-header">
        <h5 class="mb-0">Select Theater City Hall</h5>
    </div>
    <div class="card-body">
        <form asp-action="TheaterCityHallMovie" method="get" class="row g-3">
            <div class="col-md-8">
                <label for="selectedHallId" class="form-label">Theater City Hall</label>
                <select id="selectedHallId" name="selectedHallId" class="form-select">
                    <option value="">-- Select Theater City Hall --</option>
                    @foreach (var hall in Model.Halls)
                    {
                        <option value="@hall.Value" selected="@(hall.Value == Model.SelectedHallId.ToString() ? "selected" : null)">
                            @hall.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Show Movies</button>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedHallId.HasValue)
{
    <div class="card shadow mb-4">
        <div class="card-header">
            <h5 class="mb-0">Movies and Showtimes</h5>
        </div>
        <div class="card-body">
            @if (Model.Movies.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Theater</th>
                            <th>City</th>
                            <th>Movie</th>
                            <th>Duration</th>
                            <th>Language</th>
                            <th>Genre</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th>Ticket Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Movies)
                        {
                            <tr>
                                <td>@item.TheaterName</td>
                                <td>@item.TheaterCity</td>
                                <td>@item.MovieTitle</td>
                                <td>@item.Duration</td>
                                <td>@item.Language</td>
                                <td>@item.Genre</td>
                                <td>@item.ShowDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.ShowTimeName</td>
                                <td>@item.TicketPrice.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No movies/sessions found for the selected Theater City Hall.</div>
            }
        </div>
    </div>
}

@model IEnumerable<KumariCinemas.Web.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

@using System.IO
@using System.Text.RegularExpressions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    var imagesDir = System.IO.Path.Combine(Env.WebRootPath ?? string.Empty, "images");
    var imageFiles = System.IO.Directory.Exists(imagesDir) ? System.IO.Directory.GetFiles(imagesDir) : Array.Empty<string>();
    Func<string, string> normalize = s => {
        var t = (s ?? string.Empty).ToLowerInvariant();
        t = t.Replace("&", "and");
        return Regex.Replace(t, "[^a-z0-9]", string.Empty);
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movies</h1>
    <a class="btn btn-primary" asp-action="Create">Add Movie</a>
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="movies-list">
    @foreach (var movie in Model)
    {
        <div class="card mb-3">
            <div class="row g-0">
                <div class="col-md-3 d-flex align-items-center justify-content-center p-3">
                    @{
                        var titleNorm = normalize(movie.Title);
                        var matched = imageFiles.FirstOrDefault(f => {
                            var fileNorm = normalize(System.IO.Path.GetFileNameWithoutExtension(f));
                            return fileNorm.Contains(titleNorm) || titleNorm.Contains(fileNorm);
                        });
                        var imageUrl = matched != null ? Url.Content("~/images/" + System.IO.Path.GetFileName(matched)) : Url.Content("~/images/placeholder-movie.svg");
                    }
                    <img src="@imageUrl" class="img-fluid rounded" alt="@movie.Title" style="max-height:180px;" />
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>
                        <p class="card-text"><strong>Language:</strong> @movie.Language</p>
                        <p class="card-text"><strong>Genre:</strong> @movie.Genre</p>
                        <p class="card-text"><strong>Duration:</strong> @movie.Duration</p>
                        <p class="card-text"><strong>Release Date:</strong> @movie.ReleaseDate.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
                <div class="col-md-3 d-flex flex-column justify-content-center align-items-center p-3">
                    <a class="btn btn-outline-secondary w-100 mb-2" asp-action="Details" asp-route-id="@movie.MovieId">Details</a>
                    <a class="btn btn-outline-primary w-100 mb-2" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a>
                    <a class="btn btn-outline-danger w-100" asp-action="Delete" asp-route-id="@movie.MovieId">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Small responsive tweak: stack columns on very small screens */
    @@media (max-width: 576px) {
        .card .row > div { flex: 0 0 100%; max-width: 100%; }
        .card img { max-height: 140px; }
    }
</style>
